# Required
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Either a file path or inline JSON
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=

# Optional
PORT=3000
EXPLORATION_MODEL=claude-sonnet-4-20250514
SUMMARY_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-2.5-flash
MAX_SANITY_RETRIES=3
STAGE_TIMEOUT_MS=300000
PIPELINE_TIMEOUT_MS=900000
HUMAN_DELAY_MIN_MS=500
HUMAN_DELAY_MAX_MS=2000
